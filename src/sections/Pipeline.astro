---
// UI-05 — Como funciona. Ilha Preact hidratada ao ficar visível (ADR-003); o HTML do servidor é a camada estática.
import Section from '../components/Section.astro';
import PipelineIsland from '../components/islands/PipelineIsland';
import { t, type Locale } from '../i18n';
import { getExamples } from '../lib/examples';
import { toPipelineDemands } from '../lib/pipeline';
import '../styles/pipeline.css';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = t(locale);
const demands = toPipelineDemands(await getExamples(), locale);
---
<Section id="pipeline" {...ui.sections.pipeline} lead={ui.pipeline.intro} grid>
  <PipelineIsland client:visible demands={demands} labels={ui.pipeline} />
  <slot />
</Section>
