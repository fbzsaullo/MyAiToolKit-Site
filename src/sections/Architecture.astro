---
// UI-09 — Arquitetura do kit.
import Section from '../components/Section.astro';
import ArchitectureDiagram from '../components/ArchitectureDiagram.astro';
import { t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = t(locale);
---
<Section id="arquitetura" {...ui.sections.arquitetura} lead={ui.architecture.intro} grid>
  <ArchitectureDiagram locale={locale} />
</Section>
