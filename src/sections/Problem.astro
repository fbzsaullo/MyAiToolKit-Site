---
// UI-03 — O problema: o mesmo pedido solto gera resultados diferentes; a especificação gera um só.
import Section from '../components/Section.astro';
import IdTag from '../components/IdTag.astro';
import { t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = t(locale);
const p = ui.problem;
---
<Section id="problema" {...ui.sections.problema}>
  <div class="problem">
    <article class="problem__col">
      <p class="label">{p.loose.label}</p>
      <p class="problem__request">{p.loose.request}</p>
      <p class="problem__arrow" aria-hidden="true">↓</p>
      <p class="label">{p.loose.resultsLabel}</p>
      <ol class="problem__results" data-problem-results>
        {p.loose.results.map((result, index) => (
          <li class="problem__result" style={`--i: ${index}`}>
            <span class="problem__index tabular" aria-hidden="true">{index + 1}</span>
            <span>{result}</span>
          </li>
        ))}
      </ol>
    </article>

    <article class="problem__col problem__col--spec">
      <p class="label">{p.spec.label}</p>
      <p class="problem__request">{p.spec.request}</p>
      <ul class="problem__rules" role="list">
        {p.spec.rules.map((rule) => {
          const [id, text] = rule.split(': ');
          return <li><IdTag id={id} /> <span>{text}</span></li>;
        })}
      </ul>
      <p class="problem__arrow" aria-hidden="true">↓</p>
      <p class="label">{p.spec.resultLabel}</p>
      <p class="problem__decided"><span class="problem__mark" aria-hidden="true"></span>{p.spec.result}</p>
    </article>
  </div>
</Section>

<script>
  import { setupProblem } from '../scripts/problem';
  setupProblem();
</script>

<style>
  .problem {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border: var(--border) solid var(--line-strong);
  }
  .problem__col {
    display: grid;
    align-content: start;
    gap: var(--space-3);
    padding: var(--space-6);
  }
  .problem__col + .problem__col {
    border-left: var(--border) solid var(--line-strong);
  }
  .problem__col--spec {
    background: var(--surface);
  }
  .problem__request {
    font-family: var(--font-mono);
    font-size: var(--fs-code);
    font-weight: 500;
  }
  .problem__arrow {
    color: var(--text-muted);
    font-family: var(--font-mono);
  }
  .problem__results {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .problem__result {
    display: flex;
    gap: var(--space-3);
    align-items: baseline;
    padding: var(--space-3);
    border: var(--border) dashed var(--line-strong);
    color: var(--text-2);
  }
  .problem__index {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    color: var(--text-muted);
  }
  .problem__rules {
    display: grid;
    gap: var(--space-2);
    margin: 0;
  }
  .problem__rules li {
    display: flex;
    gap: var(--space-2);
    align-items: baseline;
    color: var(--text-2);
    font-size: var(--fs-small);
  }
  .problem__decided {
    display: flex;
    gap: var(--space-3);
    align-items: baseline;
    padding: var(--space-3);
    border: var(--border) solid var(--ink);
    font-weight: 500;
  }
  .problem__mark {
    flex: none;
    width: 0.625rem;
    height: 0.625rem;
    background: var(--ink);
  }

  /* Alternância: um resultado por vez, uma volta; no fim, os três ficam listados. */
  .problem__results:global(.is-cycling) {
    position: relative;
    min-height: 3.5rem;
  }
  .problem__results:global(.is-cycling) .problem__result {
    position: absolute;
    inset: 0 0 auto;
    opacity: 0;
    animation: problem-cycle 1400ms var(--ease) forwards;
    animation-delay: calc(var(--i) * 1400ms);
  }
  @keyframes problem-cycle {
    0% { opacity: 0; }
    12% { opacity: 1; }
    85% { opacity: 1; }
    100% { opacity: 0; }
  }

  @media (max-width: 767px) {
    .problem {
      grid-template-columns: minmax(0, 1fr);
    }
    .problem__col {
      padding: var(--space-5);
    }
    .problem__col + .problem__col {
      border-left: 0;
      border-top: var(--border) solid var(--line-strong);
    }
  }
</style>
