---
// Wordmark original de brand/ (RN-01): nunca redigitado, colorido ou distorcido.
// Os dois arquivos são servidos como estão (?url) e o CSS mostra o do tema atual.
import black from '../../brand/myaitoolkit-wordmark-black.svg?url';
import white from '../../brand/myaitoolkit-wordmark-white.svg?url';

interface Props {
  /** Altura em px: 20–24 no cabeçalho, 48–72 no hero ou no rodapé. */
  height: number;
  /** Texto alternativo; vazio quando o logo é decorativo ao lado de um texto equivalente. */
  alt?: string;
  class?: string;
}

const { height, alt = 'MyAiToolKit', class: className } = Astro.props;
// Proporção do viewBox original: 778,24 × 136,2.
const width = Math.round((height * 778.24) / 136.2);
---
<span class:list={['logo', className]} style={`--logo-h: ${height}px`}>
  <img class="logo__light" src={black} width={width} height={height} alt={alt} decoding="async" />
  <img class="logo__dark" src={white} width={width} height={height} alt={alt} decoding="async" />
</span>

<style>
  .logo {
    display: inline-flex;
    /* Espaço livre de pelo menos metade da altura das maiúsculas (≈ 0,38 × altura do arquivo). */
    padding: calc(var(--logo-h) * 0.38);
    margin: calc(var(--logo-h) * -0.38);
  }
  .logo img {
    height: var(--logo-h);
    width: auto;
  }
  .logo__dark {
    display: none;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .logo__light {
      display: none;
    }
    :global(:root:not([data-theme='light'])) .logo__dark {
      display: block;
    }
  }
  :global(:root[data-theme='dark']) .logo__light {
    display: none;
  }
  :global(:root[data-theme='dark']) .logo__dark {
    display: block;
  }
</style>
