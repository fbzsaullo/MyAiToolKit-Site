---
// Página única, renderizada nas duas rotas. As seções entram nas tarefas T-10 a T-21.
import Base from '../layouts/Base.astro';
import type { Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---
<Base locale={locale}>
  <main id="conteudo" class="container">
    <h1>MyAiToolKit</h1>
  </main>
</Base>
