---
// Página única, renderizada nas duas rotas. Cada seção é preenchida pela sua tarefa (T-11 a T-21).
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import Section from './Section.astro';
import Hero from '../sections/Hero.astro';
import Problem from '../sections/Problem.astro';
import WhatIs from '../sections/WhatIs.astro';
import Why from '../sections/Why.astro';
import Pipeline from '../sections/Pipeline.astro';
import Traceability from '../sections/Traceability.astro';
import Commands from '../sections/Commands.astro';
import Architecture from '../sections/Architecture.astro';
import StacksAndAIs from '../sections/StacksAndAIs.astro';
import OpenSource from '../sections/OpenSource.astro';
import CodeBlock from './CodeBlock.astro';
import { t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = t(locale);
const s = ui.sections;
---
<Base locale={locale}>
  <Header locale={locale} />
  <main id="conteudo">
    <Hero locale={locale} />
    <Problem locale={locale} />
    <WhatIs locale={locale} />
    <Pipeline locale={locale} />
    <Traceability locale={locale} />
    <Commands locale={locale} />
    <Why locale={locale} />
    <Architecture locale={locale} />
    <StacksAndAIs locale={locale} />
    <Section id="instalar" {...s.instalar}>
      <CodeBlock
        locale={locale}
        filename="terminal"
        highlight={[2]}
        code={`# provisório: substituído pela seção de instalação (T-21)
claude plugin marketplace add ./MyAiToolKit
/sdd-start`}
      />
    </Section>
    <OpenSource locale={locale} />
  </main>
  <Footer locale={locale} />
</Base>
