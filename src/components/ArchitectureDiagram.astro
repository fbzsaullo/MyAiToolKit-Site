---
// UI-09 — Diagrama da arquitetura. Ilha Preact hidratada ao ficar visível (ADR-003); o HTML do servidor
// já traz o SVG completo e a lista equivalente.
import ArchitectureIsland from './islands/ArchitectureIsland';
import { t, type Locale } from '../i18n';
import { withKitFacts } from '../lib/kit';
import '../styles/architecture.css';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = t(locale);
---
<ArchitectureIsland client:visible labels={withKitFacts(ui.architecture)} phases={ui.pipeline.phases} motion={ui.motion} />
