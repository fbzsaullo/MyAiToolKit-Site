---
// UI-01 — Cabeçalho fixo: logo, âncoras, GitHub (sem contagem), tema e idioma (SPEC-UI-001).
// Sem JS, o menu do celular é um <details> nativo e as trocas de idioma são links.
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { homePath, t, type Locale } from '../i18n';
import { KIT_REPO, NAV_SECTIONS } from '../lib/links';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = t(locale);
---
<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-header__home" href={homePath(locale)} aria-label={ui.header.home}>
      <Logo height={22} alt="" />
    </a>

    <nav class="site-header__nav" aria-label={ui.header.navLabel}>
      <ul role="list" class="site-header__links">
        {NAV_SECTIONS.map((id) => (
          <li><a href={`#${id}`} data-nav={id}>{ui.nav[id]}</a></li>
        ))}
      </ul>
    </nav>

    <div class="site-header__actions">
      <a class="site-header__github" href={KIT_REPO} rel="noopener">{ui.header.github}</a>

      <button type="button" class="icon-button" data-theme-toggle
        data-label-system={ui.header.theme.system}
        data-label-light={ui.header.theme.light}
        data-label-dark={ui.header.theme.dark}
        aria-label={ui.header.theme.system}>
        <span data-theme-icon="system"><Icon name="Monitor" size={20} /></span>
        <span data-theme-icon="light" hidden><Icon name="Sun" size={20} /></span>
        <span data-theme-icon="dark" hidden><Icon name="Moon" size={20} /></span>
      </button>

      <ul role="list" class="lang-switch" aria-label={ui.header.language.label}>
        <li><a href={homePath('pt-BR')} hreflang="pt-BR" lang="pt-BR" data-lang="pt-BR" aria-current={locale === 'pt-BR' ? 'true' : undefined} aria-label={ui.header.language.ptName}>{ui.header.language.pt}</a></li>
        <li aria-hidden="true">·</li>
        <li><a href={homePath('en')} hreflang="en" lang="en" data-lang="en" aria-current={locale === 'en' ? 'true' : undefined} aria-label={ui.header.language.enName}>{ui.header.language.en}</a></li>
      </ul>

      <details class="site-header__menu" data-menu>
        <summary class="icon-button" aria-label={ui.header.menu}>
          <Icon name="Menu" size={20} />
        </summary>
        <nav class="site-header__panel" aria-label={ui.header.navLabel}>
          <ul role="list">
            {NAV_SECTIONS.map((id) => (
              <li><a href={`#${id}`} data-nav={id}>{ui.nav[id]}</a></li>
            ))}
            <li><a href={KIT_REPO} rel="noopener">{ui.header.github}</a></li>
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  import { setupHeader } from '../scripts/header';
  setupHeader();
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--header-h);
    background: var(--bg);
    border-bottom: var(--border) solid var(--line);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    height: 100%;
  }
  .site-header__home {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-right: auto;
  }
  .site-header__links {
    display: flex;
    gap: var(--space-5);
    margin: 0;
  }
  .site-header__links a,
  .site-header__github,
  .lang-switch a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    font-size: var(--fs-small);
    font-weight: 500;
    text-decoration: none;
    color: var(--text-2);
  }
  .site-header__links a:hover,
  .site-header__github:hover,
  .lang-switch a:hover {
    color: var(--text);
    text-decoration: underline;
  }
  /* Seção ativa: quadrado preenchido antes do rótulo */
  .site-header__links a[aria-current='true'] {
    color: var(--text);
  }
  .site-header__links a::before {
    content: '';
    width: 0.375rem;
    height: 0.375rem;
    border: var(--border) solid currentColor;
    opacity: 0;
  }
  .site-header__links a[aria-current='true']::before {
    opacity: 1;
    background: currentColor;
  }
  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .lang-switch {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    margin: 0;
    color: var(--text-muted);
    font-family: var(--font-mono);
  }
  .lang-switch a {
    min-width: 44px;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: var(--ls-label);
  }
  .lang-switch a[aria-current='true'] {
    color: var(--text);
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }
  .site-header__menu {
    display: none;
    position: relative;
  }
  .site-header__menu > summary {
    list-style: none;
  }
  .site-header__menu > summary::-webkit-details-marker {
    display: none;
  }
  .site-header__panel {
    position: absolute;
    right: 0;
    top: calc(100% + var(--space-2));
    min-width: 14rem;
    padding: var(--space-2);
    background: var(--bg);
    border: var(--border) solid var(--line-strong);
  }
  .site-header__panel ul {
    margin: 0;
  }
  .site-header__panel a {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 0 var(--space-3);
    text-decoration: none;
    font-weight: 500;
  }
  .site-header__panel a:hover {
    background: var(--surface-2);
  }

  @media (max-width: 899px) {
    .site-header__nav,
    .site-header__github {
      display: none;
    }
    .site-header__menu {
      display: block;
    }
  }
</style>

<style is:global>
  .icon-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-sm);
    color: var(--text);
    cursor: pointer;
    transition: background-color var(--dur-fast) var(--ease);
  }
  .icon-button:hover {
    background: var(--surface-2);
  }
  .icon-button [hidden] {
    display: none;
  }
</style>
