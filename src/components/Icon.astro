---
// Ícones Lucide renderizados no build (zero JS): traço quadrado, junção em quina, 1,75 px a 24 px.
import { icons } from 'lucide';

type IconNode = [string, Record<string, string | number>][];

interface Props {
  name: keyof typeof icons;
  size?: number;
  label?: string;
  class?: string;
}

const { name, size = 24, label, class: className } = Astro.props;
const node = icons[name] as unknown as IconNode;
if (!node) throw new Error(`Ícone Lucide inexistente: ${String(name)}`);
---
<svg
  class:list={['icon', className]}
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="square"
  stroke-linejoin="miter"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>
  {node.map(([tag, attrs]) => {
    const Tag = tag;
    return <Tag {...attrs} />;
  })}
</svg>
